# Base URL backend Barokahiin (tanpa trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Prefix endpoint publik Barokahiin API v1
VITE_API_PUBLIC_PREFIX=/api/public

# Prefix endpoint wilayah administratif
VITE_API_WILAYAH_PREFIX=/api/v1/public

# Identitas aplikasi storefront
VITE_APP_NAME=Barokahiin
VITE_APP_TAGLINE=Barang yang kamu beli, kebaikan yang kita danai.
